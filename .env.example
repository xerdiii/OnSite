# Copy to .env.local and fill in. .env.local is gitignored.
# In production these same three live in Vercel → Settings →
# Environment Variables, and a redeploy is required before they apply.

# Required. From resend.com → API Keys. Without it /api/contact
# answers 503 and both forms say nothing was delivered.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries arrive. Any mailbox; it does not have to be your
# domain. Defaults to hello@xovahweb.com when unset.
NOTIFY_EMAIL=hello@xovahweb.com

# Who they are sent AS. This domain MUST be verified in Resend →
# Domains, or Resend rejects the send and the form reports a failure.
# Defaults to "Xovahweb <hello@xovahweb.com>" when unset.
FROM_EMAIL=Xovahweb <hello@xovahweb.com>

# Optional. From google.com/recaptcha, registered as
# "reCAPTCHA v2 -> I am not a robot". v2 and v3 keys are NOT
# interchangeable. When set, project requests must carry a token from
# the checkbox; when unset, the form behaves as it did before.
# The matching SITE key is public and goes in build.html, not here.
RECAPTCHA_SECRET_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
