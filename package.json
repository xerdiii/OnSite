{
  "name": "xovah",
  "version": "1.0.0",
  "description": "Xovah — professional websites for small businesses.",
  "scripts": {
    "css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o assets/tailwind.css --minify",
    "css:watch": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o assets/tailwind.css --watch",
    "dev": "node dev-server.js",
    "bloom": "esbuild src/bloom/main.js --bundle --minify --format=iife --target=es2019 --legal-comments=none --outfile=assets/bloom.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xerdiii/Sitehouse.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/xerdiii/Xovah/issues"
  },
  "homepage": "https://www.xovahweb.com",
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tailwindcss": "^3.4.17",
    "three": "^0.186.0"
  },
  "private": true
}
